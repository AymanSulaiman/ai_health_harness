{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique per agent run on one test case"
    },
    "suite_run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Shared by every run in one pass over the dataset"
    },
    "test_case_id": {
      "type": "string",
      "minLength": 1,
      "description": "case_id in datasets/notes_<version>.jsonl, e.g. v1-001"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "agent_version": {
      "type": "string",
      "minLength": 1
    },
    "agent_model": {
      "type": "string",
      "minLength": 1,
      "description": "e.g. an Ollama model tag"
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "judge_model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "null when no LLM judge scored this run"
    },
    "judge_prompt_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "description": "Arguments the agent passed, as JSON"
          },
          "output": {
            "description": "What the tool returned, as JSON; null if it failed"
          },
          "latency_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "input",
          "output",
          "latency_ms"
        ],
        "additionalProperties": false
      }
    },
    "input_tokens": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ],
      "description": "null when the model call failed"
    },
    "output_tokens": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Wall time of the whole agent run"
    },
    "raw_output": {
      "description": "The model's text as returned; null when the model call failed",
      "type": [
        "string",
        "null"
      ]
    },
    "parsed_output": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "narrative": {
              "type": "string",
              "description": "A few sentences a clinician could read at a glance"
            },
            "medications": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Drug with strength and form, as written in the note"
                  },
                  "dose": {
                    "description": "Amount per dose now in effect, e.g. '1 tablet'; null if not stated",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "frequency": {
                    "description": "e.g. 'twice daily', 'as needed'; null if not stated",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "name",
                  "dose",
                  "frequency"
                ],
                "additionalProperties": false
              },
              "description": "Medications the patient currently takes"
            },
            "allergies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "substance": {
                    "type": "string"
                  },
                  "reactions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Empty if none are stated"
                  }
                },
                "required": [
                  "substance",
                  "reactions"
                ],
                "additionalProperties": false
              }
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Active conditions"
            }
          },
          "required": [
            "narrative",
            "medications",
            "allergies",
            "conditions"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "raw_output parsed into the summary; null when parsing failed"
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scorer": {
            "type": "string",
            "minLength": 1,
            "description": "e.g. medication_recall, allergy_recall, dose_match, judge"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "description": "Why, in a sentence: what was missed, or the judge's reasoning",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "scorer",
          "value",
          "passed",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "stage": {
              "type": "string",
              "enum": [
                "model",
                "parse",
                "score"
              ],
              "description": "Where the run failed"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "stage",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "run_id",
    "suite_run_id",
    "test_case_id",
    "dataset_version",
    "agent_version",
    "agent_model",
    "prompt_version",
    "judge_model",
    "judge_prompt_version",
    "tool_calls",
    "input_tokens",
    "output_tokens",
    "latency_ms",
    "raw_output",
    "parsed_output",
    "scores",
    "error",
    "created_at"
  ],
  "additionalProperties": false,
  "title": "TraceEvent",
  "description": "One agent run on one test case. One event per line in the trace files."
}
